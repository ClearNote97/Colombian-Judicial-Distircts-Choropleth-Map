{
  "name": "colombian-judicial-choropleth",
  // 🐳 Imagen base de Dev Containers (incluye VS Code + Python)
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  // 📂 Carpeta de trabajo dentro del contenedor
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  // 🐍 src-layout: el paquete judicial_map vive en src/ -> importable sin instalar
  "containerEnv": {
    "PYTHONPATH": "${containerWorkspaceFolder}/src"
  },
  "customizations": {
    // ⚙️ Personalizaciones adicionales para VS Code
    "vscode": {
      "settings": {
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
          }
        },
        // Se establece el intérprete de Python dentro del entorno virtual creado por uv
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.analysis.typeCheckingMode": "basic",
        "python.analysis.inlayHints.variableTypes": true,
        "python.analysis.inlayHints.functionReturnTypes": true,
        "editor.wordWrap": "on",
        "workbench.iconTheme": "material-icon-theme"
      },
      // Extensiones recomendadas para una experiencia de desarrollo óptima
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "ms-toolsai.jupyter",
        "tamasfe.even-better-toml",
        "github.copilot",
        "christian-kohler.path-intellisense",
        "pkief.material-icon-theme"
      ]
    }
  },
  // 👤 Usuario por defecto en el contenedor
  "remoteUser": "root",

  // 🐍 Comando para instalar dependencias usando uv, que es un gestor de paquetes moderno y eficiente. Se verifica si existe pyproject.toml o requirements.txt para decidir cómo instalar las dependencias.
  "postCreateCommand": "sh -lc 'if [ -f pyproject.toml ]; then if [ -f uv.lock ]; then uv sync --locked; else uv lock && uv sync; fi; elif [ -f requirements.txt ]; then uv init --no-package --no-workspace . && rm -f main.py && uv add -r requirements.txt; else echo \"No se encontró ni pyproject.toml ni requirements.txt\" >&2; exit 1; fi'"
}